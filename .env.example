# Deployer private key (EOA — pays gas only, discard after deploy)
# Never commit a real key. contracts/.env is git-ignored.
DEPLOYER_PRIVATE_KEY=

# opBNB RPC. Public endpoint shown; a dedicated provider is more reliable.
OPBNB_RPC=https://opbnb-mainnet-rpc.bnbchain.org

# Governance addresses wired into the constructors (see deployment-addresses.json for the live values).
# DEFAULT_ADMIN_ROLE — put behind a timelock/multisig before points carry value.
ADMIN_ADDR=
# GUARDIAN_ROLE — separate key: pause (not unpause) + immediate attestor revoke.
GUARDIAN_ADDR=
# AgentPassport mint-voucher signer. Separate from admin/guardian.
ISSUER_ADDR=

# opBNBScan API key — only needed for contract verification.
OPBNBSCAN_API_KEY=
