# Deployer private key (EOA — pays gas only, discard after deploy)
# Never commit a real key. contracts/.env is git-ignored.
DEPLOYER_PRIVATE_KEY=

# Multisig address that receives contract ownership after deploy.
# Both contracts are transferred to this Safe; the deployer EOA keeps nothing.
OWNER_SAFE=

# opBNB RPC. Defaults to the public endpoint when unset.
# A dedicated provider endpoint is more reliable under load:
# OPBNB_RPC=https://opbnb-mainnet.nodereal.io/v1/YOUR_PROVIDER_KEY
OPBNB_RPC=

# opBNBScan / BscScan API key — only needed for contract verification.
# Get one free at: https://bscscan.com/apis
OPBNBSCAN_API_KEY=
